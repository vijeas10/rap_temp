@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName: 'UX Team',
                typeNamePlural: 'UX Teams',
                typeImageUrl: 'sap-icon://employee',
                title: { type: #STANDARD, label: 'UXTeam', value: 'Id' }  }
//                presentationVariant: [{ sortOrder: [{ by: 'Id', direction:  #ASC }] }]
 }
//Display Multiple views in List Report page for single table
@UI.selectionVariant: [{  qualifier: 'All', text: 'All'},
                       {  qualifier: 'Active', text: 'Developers', filter:'Salary EQ 7000'},
                       {  qualifier: 'Inactive', text: 'Leads', filter:'Salary EQ 9000'     }
]


@UI.lineItem: [{ criticality: 'activecriticality' }]
annotate view zc_uxteam_vije with

{
  @UI.facet: [ { id: 'idHeader',
                 position: 10,
                 purpose: #HEADER,
                 type: #DATAPOINT_REFERENCE,
                 targetQualifier: 'qfFirstName' },
               { id: 'idHeader2',
                 position: 20,
                 purpose: #HEADER,
                 type: #DATAPOINT_REFERENCE,
                 targetQualifier: 'qfLastName' },
               { id: 'Demo',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Demo',
                 position: 30 } ]
  @UI.identification: [ { position: 1, label: 'Id' } ]
  Id;

  @UI: {  lineItem:       [ { position: 20 , type: #WITH_INTENT_BASED_NAVIGATION, semanticObjectAction: 'display' ,semanticObject: 'bank' }
  //       { type: #WITH_INTENT_BASED_NAVIGATION, semanticObjectAction: 'display' ,semanticObject: 'bank', label: 'Display Bank' } it will add new column
       ],
        identification: [ { position: 20 }
  //          , { type: #WITH_INTENT_BASED_NAVIGATION, semanticObjectAction: 'display' ,semanticObject: 'bank', label: 'Display Bank' } it will add new column
        ],
        selectionField: [ { position: 20 } ],
         dataPoint: { qualifier: 'qfFirstName', title: 'First Name' }

          }
  @Consumption.semanticObject: 'bank'
  Firstname;

  @UI.dataPoint.qualifier: 'qfLastName'
  @UI.identification: [ { position: 30 } ]
  @UI.lineItem: [ { position: 30 } ]
  @UI.selectionField: [ { position: 30 } ]
  Lastname;

  @UI.identification: [ { position: 40 } ]
  @UI.lineItem: [ { position: 40 } ]
  Age;

  @UI.identification: [ { position: 50 } ]
  @UI.lineItem: [ { position: 50 } ]
  Role;

  @UI: {  lineItem:       [ { position: 60 }
  //  ,{ type: #FOR_ACTION, dataAction: 'CopyMember', label: 'Copy Member' }
   ],
       identification: [ { position: 60 } ],
       selectionField: [ { position: 60 } ] }
  Salary;

  @UI.identification: [ { position: 70 ,criticality: 'activecriticality' ,criticalityRepresentation: #WITHOUT_ICON} ]
  @UI.lineItem: [ { position: 70 ,criticality: 'activecriticality',criticalityRepresentation: #WITHOUT_ICON},
                  { type: #FOR_ACTION, dataAction: 'setActive', label: 'Set Active' },
                  { type: #FOR_ACTION, dataAction: 'CopyMember', label: 'Copy' },
                  { type: #FOR_ACTION, dataAction: 'CreateInstance', label: 'Create Instance' } ]
  @UI.selectionField: [ { position: 70 } ]
  Active;

  @UI.hidden: true
  // @EndUserText.label: 'Last Changed At'
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
  @UI.hidden: true
  activecriticality;
}